# BCE ENGINE host record (D-041): the SQLite store is runtime state, never in git.
# A fresh clone starts empty; the client one-time-imports any IndexedDB saves on first boot.
.data/
*.db
*.db-journal
*.db-wal
*.db-shm

# D-055 (REF-001 LETTER-STRICT): the build-time catalog SEED caches the MekBay/MegaMek equipment
# WITNESS (db.mekbay.com/equipment2.json) here for offline re-runs. It is a reference witness, NEVER
# the shipped artifact — never commit it. The catalog itself is BCE-authored rules data, cited, baked
# into the (also-ignored) SQLite store by the seed.
.seed-cache/
